<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Trovami.Core\Trovami.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <!-- QR codes for the label print sheet and the phone pairing code, drawn as SVG. -->
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <!-- Pinned: the version that reaches this project transitively (10.0.0) has known vulnerabilities. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Real cultures are needed for the region formats (de-CH dates, en-US numbers...). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The version shown in the app (AppInfo.Version). Local builds say "dev"; the Docker build
         passes the release version (-p:InformationalVersion=1.2.0) from the git tag. The SDK
         would otherwise append "+<commit hash>". -->
    <InformationalVersion>dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UserSecretsId>5fa9a6d2-fda3-4397-a4f9-c1f04067655e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The release notes page shows the repository's CHANGELOG.md, built into the app. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The day this build was made (AppInfo.BuildDate). -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd'))" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Trovami.Tests" />
  </ItemGroup>

</Project>
