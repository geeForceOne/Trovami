@page "/household"
@inherits AppPage
@inject HouseholdService Households
@inject HouseholdInviteService Invites
@using Trovami.Core.Security
@inject AiNamingService Ai
@inject AiTranslationService Translation
@inject Trovami.Core.Backup.BackupService Backups
@inject ILogger<HouseholdPage> Log

<PageTitle>Household · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>@(Household?.Name ?? "Household")</h1>
        <p class="page-sub">
            @if (Household is { } h)
            {
                @(h.IsOwner ? "You own this household: you manage its members and its AI." : $"{h.OwnerName} owns this household. You see and edit everything in it.")
            }
        </p>
    </div>
</div>

<div class="settings">
    @if (Household is { } household)
    {
        @if (household.IsOwner)
        {
            <section class="setting">
                <div class="setting-intro">
                    <h2>Name</h2>
                    <p>What everyone in the household sees.</p>
                </div>
                <div class="setting-body">
                    <form class="inline-add" @onsubmit="RenameAsync" @onsubmit:preventDefault="true">
                        <input data-bwignore="true" class="input" @bind="_name" @bind:event="oninput" maxlength="@Trovami.Core.Models.Household.MaxNameLength" aria-label="Household name" />
                        <button type="submit" class="btn btn-secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(_name) || _name.Trim() == household.Name)">Rename</button>
                    </form>
                </div>
            </section>
        }

        <section class="setting">
            <div class="setting-intro">
                <h2>Members</h2>
                <p>Everyone here sees and edits all locations and items.</p>
            </div>
            <div class="setting-body">
                <ul class="member-list">
                    @foreach (var m in _members)
                    {
                        <li>
                            <span class="avatar">@m.Name[..1].ToUpperInvariant()</span>
                            <span class="member-text">
                                <span>@m.Name @if (m.IsOwner) {<span class="tag tag-quiet">Owner</span>}</span>
                                <span class="muted small">@m.Email</span>
                            </span>
                            @if (household.IsOwner && !m.IsOwner)
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => RemoveAsync(m)">Remove</button>
                            }
                        </li>
                    }
                    @foreach (var i in _invites)
                    {
                        <li class="pending">
                            <span class="avatar"><Icon Name="mail" Size="16" /></span>
                            <span class="member-text">
                                <span>@i.UserName <span class="tag tag-quiet">Invited</span></span>
                                <span class="muted small">@i.Email · @Format.Ago(i.CreatedAt)</span>
                            </span>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => CancelInviteAsync(i)">Cancel</button>
                        </li>
                    }
                </ul>

                @if (household.IsOwner)
                {
                    <form class="form invite-form" @onsubmit="InviteAsync" @onsubmit:preventDefault="true">
                        <h3>Invite someone</h3>
                        <div class="field-row field-row-wrap">
                            <label class="field field-grow">
                                <span>Email address</span>
                                <input data-bwignore="true" class="input" type="text" inputmode="email" @bind="_inviteEmail" @bind:event="oninput" autocomplete="off" spellcheck="false" />
                            </label>
                            <label class="field field-grow">
                                <span>Name <span class="muted">(if they're new to @AppInfo.Name)</span></span>
                                <input data-bwignore="true" class="input" @bind="_inviteName" @bind:event="oninput" maxlength="@AppUser.MaxDisplayNameLength" autocomplete="off" />
                            </label>
                        </div>
                        <div class="actions">
                            <button type="submit" class="btn btn-primary" disabled="@(Busy || string.IsNullOrWhiteSpace(_inviteEmail))"><Icon Name="send" Size="16" /> Invite</button>
                        </div>
                        @if (_inviteResult is not null)
                        {
                            <div class="notice @(_inviteResult.Link is null ? "notice-good" : "notice-warn")" role="status">
                                @_inviteResult.Message
                                @if (_inviteResult.Link is not null)
                                {
                                    <div class="link-copy"><input data-bwignore="true" class="input input-code" readonly value="@_inviteResult.Link" /></div>
                                }
                            </div>
                        }
                    </form>
                }
            </div>
        </section>

        @if (household.IsOwner && _ai is not null)
        {
            <section class="setting">
                <div class="setting-intro">
                    <h2>AI</h2>
                    <p>Items added with a photo get their name (unless one was typed) and keywords from the AI. It uses this household's own key, which never leaves the server.</p>
                </div>
                <div class="setting-body">
                    <form class="form" @onsubmit="SaveAiAsync" @onsubmit:preventDefault="true">
                        <div class="segmented segmented-wide" role="radiogroup" aria-label="AI provider">
                            @foreach (var p in new[] { AiProvider.None, AiProvider.Claude, AiProvider.OpenAi })
                            {
                                <button type="button" class="@(_provider == p ? "on" : "")" role="radio" aria-checked="@(_provider == p ? "true" : "false")" @onclick="() => PickProvider(p)">@AiModels.ProviderName(p)</button>
                            }
                        </div>
                        @if (_provider != AiProvider.None)
                        {
                            <label class="field">
                                <span>Model</span>
                                <select class="select" @bind="_model">
                                    @foreach (var m in AiModels.For(_provider))
                                    {
                                        <option value="@m.Id">@m.Name</option>
                                    }
                                </select>
                                <span class="field-hint">@AiModels.For(_provider).FirstOrDefault(m => m.Id == _model)?.Description</span>
                            </label>
                            <label class="field">
                                <span>API key</span>
                                <input data-bwignore="true" data-1p-ignore data-lpignore="true" data-form-type="other" class="input input-key" type="password" @bind="_key" @bind:event="oninput" autocomplete="new-password" spellcheck="false"
                                       placeholder="@(_ai.Key == SecretStatus.Set && _provider == _ai.Provider ? "Saved; type to replace it" : _provider == AiProvider.Claude ? "sk-ant-…" : "sk-…")" />
                                @if (_ai.Key == SecretStatus.Unreadable && _provider == _ai.Provider)
                                {
                                    <span class="field-error">The saved key can't be read anymore. Enter it again.</span>
                                }
                                <span class="field-hint">
                                    @(_provider == AiProvider.Claude ? "Create one at console.anthropic.com under API keys." : "Create one at platform.openai.com under API keys.")
                                    Naming an item costs a fraction of a cent with the recommended model.
                                </span>
                            </label>
                        }
                        <div class="actions">
                            <button type="submit" class="btn btn-primary" disabled="@Busy">Save</button>
                        </div>
                    </form>
                </div>
            </section>
        }

        @if (household.IsOwner)
        {
            var language = AiLanguages.For(household.AiLanguage);
            <section class="setting">
                <div class="setting-intro">
                    <h2>Language</h2>
                    <p>The AI writes names and keywords in this language, and the keywords "@language.New" and "@language.Unsure" follow it. @AppInfo.Name's own pages stay in US English.</p>
                </div>
                <div class="setting-body">
                    <form class="form" @onsubmit="SaveLanguageAsync" @onsubmit:preventDefault="true">
                        <label class="field">
                            <span>Language</span>
                            <select class="select" @bind="_language">
                                @foreach (var l in AiLanguages.All)
                                {
                                    <option value="@l.Code">@l.Name</option>
                                }
                            </select>
                        </label>
                        <div class="actions">
                            <button type="submit" class="btn btn-primary" disabled="@(Busy || _language == household.AiLanguage)">Save</button>
                        </div>
                    </form>

                    <NamingWatcher Active="_translation?.Running == true" OnTick="RefreshTranslationAsync" MaxTicks="1200" />
                    <div class="form invite-form">
                        <h3>Translate everything</h3>
                        @if (_translation is { Running: true } running)
                        {
                            <p class="notice" role="status">@($"Translating into {running.LanguageName}{(running.Total > 0 ? $": {Format.Number(running.Done)} of {Format.Number(running.Total)} done" : "")}. You can leave this page.")</p>
                        }
                        else
                        {
                            @if (_translation is { } finished)
                            {
                                <p class="notice @(finished.Failed == 0 ? "notice-good" : "notice-warn")" role="status">
                                    @(finished.Failed == 0 ? $"Everything is translated into {finished.LanguageName}." : $"Translated into {finished.LanguageName}, except {Format.Number(finished.Failed)} that stayed as they were. Translating again only changes what isn't in {finished.LanguageName} yet.")
                                    @finished.Error
                                </p>
                            }
                            <p class="muted">Puts what's already here into @language.Name: item names (typed ones too), item notes, and the keywords of items and locations. Location names, notes and labels stay as they are.</p>
                            @if (_counts is { } c)
                            {
                                <p class="muted">@($"That's {Format.Count(c.Names, "name", "names")}, {Format.Count(c.Notes, "note", "notes")} and {Format.Count(c.Keywords, "keyword", "keywords")}. It uses this household's AI key and can't be undone.")</p>
                                @if (_isAdmin)
                                {
                                    <label class="check"><input type="checkbox" @bind="_backupFirst" /> Make a backup first</label>
                                }
                                else
                                {
                                    <p class="field-hint">Only an admin can make a backup. Ask them first if you want one.</p>
                                }
                                @if (!c.HasAi)
                                {
                                    <p class="field-hint">Set up the AI above first.</p>
                                }
                                <div class="actions">
                                    <button type="button" class="btn btn-secondary" disabled="@(Busy || !c.HasAi || c.Total == 0 || _language != household.AiLanguage)" @onclick="TranslateAsync">Translate into @language.Name</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </section>

            <section class="setting">
                <div class="setting-intro">
                    <h2>New items</h2>
                    <p>Every item added gets the keyword "@language.New", so you can go through what came in. Take it off by hand, or let it come off by itself after a while.</p>
                </div>
                <div class="setting-body">
                    <form class="form" @onsubmit="SaveNewKeywordDaysAsync" @onsubmit:preventDefault="true">
                        <label class="field">
                            <span>Remove "@language.New" after this many days</span>
                            <input data-bwignore="true" class="input input-short" type="number" min="1" max="@Trovami.Core.Models.Household.MaxNewKeywordDays" @bind="_newKeywordDays" @bind:event="oninput" autocomplete="off" />
                            <span class="field-hint">Leave it empty to keep "@language.New" until it's removed by hand.</span>
                        </label>
                        <div class="actions">
                            <button type="submit" class="btn btn-primary" disabled="@Busy">Save</button>
                        </div>
                    </form>
                </div>
            </section>
        }

        <section class="setting">
            <div class="setting-intro">
                <h2>@(household.IsOwner ? "Delete household" : "Leave household")</h2>
                <p>@(household.IsOwner ? "Removes the household with all its locations, items, photos and tags, for everyone." : "You stop seeing it; everything in it stays for the others.")</p>
            </div>
            <div class="setting-body">
                <div class="actions">
                    @if (household.IsOwner)
                    {
                        <button type="button" class="btn btn-danger" @onclick="DeleteAsync">Delete @household.Name</button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-secondary" @onclick="LeaveAsync">Leave @household.Name</button>
                    }
                </div>
            </div>
        </section>
    }

    <section class="setting" id="new">
        <div class="setting-intro">
            <h2>New household</h2>
            <p>For another place with its own things and people, like a holiday flat or a parent's house.</p>
        </div>
        <div class="setting-body">
            <form class="inline-add" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                <input data-bwignore="true" class="input" @bind="_newName" @bind:event="oninput" placeholder="Name" maxlength="@Trovami.Core.Models.Household.MaxNameLength" aria-label="New household name" autofocus="@New" />
                <button type="submit" class="btn btn-secondary" disabled="@(Busy || string.IsNullOrWhiteSpace(_newName))"><Icon Name="plus" Size="16" /> Create</button>
            </form>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "new")] public bool New { get; set; }

    private string _name = "";
    private IReadOnlyList<MemberView> _members = [];
    private IReadOnlyList<InviteView> _invites = [];
    private string _inviteEmail = "";
    private string _inviteName = "";
    private HouseholdInviteResult? _inviteResult;
    private AiSettingsView? _ai;
    private AiProvider _provider;
    private string _model = "";
    private string _key = "";
    private string _newName = "";
    private int? _newKeywordDays;
    private string _language = AiLanguages.DefaultCode;
    private TranslationCounts? _counts;
    private TranslationStatus? _translation;
    private bool _isAdmin;
    private bool _backupFirst = true;

    protected override async Task OnInitializedAsync()
    {
        ReloadOnHouseholdChange(LoadAsync);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _inviteResult = null;
        if (Household is not { } h)
            return;
        var userId = await UserIdAsync();
        _name = h.Name;
        _newKeywordDays = h.NewKeywordDays > 0 ? h.NewKeywordDays : null;
        _members = await Households.MembersAsync(userId, h.Id, PageToken);
        _invites = h.IsOwner ? await Households.InvitesAsync(userId, h.Id, PageToken) : [];
        _ai = h.IsOwner ? await Ai.GetSettingsAsync(userId, h.Id, PageToken) : null;
        _language = h.AiLanguage;
        _isAdmin = await IsAdminAsync();
        _counts = h.IsOwner ? await Translation.CountsAsync(userId, h.Id, PageToken) : null;
        _translation = h.IsOwner ? Translation.StatusOf(h.Id) : null;
        if (_ai is not null)
        {
            _provider = _ai.Provider;
            _model = _ai.Model;
            _key = "";
        }
    }

    private void PickProvider(AiProvider provider)
    {
        _provider = provider;
        _model = provider == _ai?.Provider ? _ai.Model : AiModels.DefaultFor(provider);
    }

    private async Task RenameAsync()
    {
        if (await RunAsync(async () => await Households.RenameAsync(await UserIdAsync(), Household!.Id, _name, PageToken)))
            await Ui.RefreshAsync();
    }

    private async Task InviteAsync()
    {
        await RunAsync(async () =>
        {
            _inviteResult = await Invites.InviteAsync(await UserIdAsync(), Household!.Id, _inviteEmail, _inviteName, Nav.BaseUri, PageToken);
            var result = _inviteResult;
            _inviteEmail = _inviteName = "";
            await LoadAsync();
            _inviteResult = result;
        });
    }

    private async Task RemoveAsync(MemberView member)
    {
        if (!await Ui.Confirm.AskAsync($"Remove {member.Name}?", "They stop seeing this household. Everything they added stays.", "Remove", danger: true))
            return;
        await RunAsync(async () =>
        {
            await Households.RemoveMemberAsync(await UserIdAsync(), Household!.Id, member.UserId, PageToken);
            await LoadAsync();
        });
    }

    private async Task CancelInviteAsync(InviteView invite)
    {
        await RunAsync(async () =>
        {
            await Households.CancelInviteAsync(await UserIdAsync(), invite.Id, PageToken);
            await LoadAsync();
        });
    }

    private async Task SaveAiAsync()
    {
        var key = string.IsNullOrWhiteSpace(_key) ? null : _key;
        if (_provider != AiProvider.None && key is null && (_ai?.Key != SecretStatus.Set || _provider != _ai.Provider))
        {
            Ui.Toast.Error("Enter the API key.");
            return;
        }
        if (await RunAsync(async () =>
        {
            await Ai.SaveSettingsAsync(await UserIdAsync(), Household!.Id, _provider, _model, key, PageToken);
            await LoadAsync();
        }))
            Ui.Toast.Success(_provider == AiProvider.None ? "AI naming is off." : "Saved. New photos are named from now on, and items that couldn't be named are tried again.");
    }

    private async Task SaveNewKeywordDaysAsync()
    {
        if (await RunAsync(async () =>
        {
            await Households.SetNewKeywordDaysAsync(await UserIdAsync(), Household!.Id, _newKeywordDays ?? 0, PageToken);
            await Ui.RefreshAsync();
        }))
            Ui.Toast.Success(_newKeywordDays is null ? "Saved. \"new\" now stays until it's removed by hand." : "Saved.");
    }

    private async Task SaveLanguageAsync()
    {
        if (await RunAsync(async () =>
        {
            await Households.SetAiLanguageAsync(await UserIdAsync(), Household!.Id, _language, PageToken);
            await Ui.RefreshAsync();
        }))
            Ui.Toast.Success($"Saved. The AI now writes in {AiLanguages.For(_language).Name}.");
    }

    private async Task RefreshTranslationAsync()
    {
        if (Household is not { } h)
            return;
        _translation = Translation.StatusOf(h.Id);
        if (_translation is { Running: false })
            _counts = await Translation.CountsAsync(await UserIdAsync(), h.Id, PageToken);
    }

    private async Task TranslateAsync()
    {
        var h = Household!;
        var name = AiLanguages.For(h.AiLanguage).Name;
        var c = _counts!;
        if (!await Ui.Confirm.AskAsync($"Translate everything into {name}?",
            $"{Format.Count(c.Names, "name", "names")}, {Format.Count(c.Notes, "note", "notes")} and {Format.Count(c.Keywords, "keyword", "keywords")} change for everyone in the household, typed names too. This uses the household's AI key and can't be undone.",
            "Translate", danger: true))
            return;
        await RunAsync(async () =>
        {
            if (_isAdmin && _backupFirst)
            {
                try
                {
                    await Backups.CreateStoredAsync("manual-", Trovami.Core.Backup.BackupService.MaxKeep, PageToken);
                }
                catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
                {
                    Log.LogError(ex, "The backup before translating failed");
                    throw new InputException("The backup failed, so nothing was translated.");
                }
            }
            await Translation.StartAsync(await UserIdAsync(), h.Id, PageToken);
            _translation = Translation.StatusOf(h.Id);
        });
    }

    private async Task DeleteAsync()
    {
        var h = Household!;
        if (!await Ui.Confirm.AskAsync($"Delete {h.Name}?", "All its locations, items, photos and tags are removed for everyone. This can't be undone.", "Delete household", danger: true, typedConfirmation: h.Name))
            return;
        if (await RunAsync(async () => await Households.DeleteAsync(await UserIdAsync(), h.Id, PageToken)))
        {
            await Ui.RefreshAsync();
            Nav.NavigateTo("");
        }
    }

    private async Task LeaveAsync()
    {
        var h = Household!;
        if (!await Ui.Confirm.AskAsync($"Leave {h.Name}?", "You stop seeing it. To come back, the owner invites you again.", "Leave"))
            return;
        if (await RunAsync(async () => await Households.RemoveMemberAsync(await UserIdAsync(), h.Id, await UserIdAsync(), PageToken)))
        {
            await Ui.RefreshAsync();
            Nav.NavigateTo("");
        }
    }

    private async Task CreateAsync()
    {
        if (await RunAsync(async () => await Households.CreateAsync(await UserIdAsync(), _newName, PageToken)))
        {
            Ui.Toast.Success($"{_newName.Trim()} is created and shown now.");
            _newName = "";
            await Ui.RefreshAsync();
            Nav.NavigateTo("");
        }
    }
}
