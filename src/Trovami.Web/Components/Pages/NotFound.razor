@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Not found · @AppInfo.Name</PageTitle>

<div class="empty">
    <h2>There's nothing at this address</h2>
    <p>The page may have been deleted, or the link is wrong.</p>
    <a class="btn btn-secondary" href="">Go to the locations</a>
</div>
