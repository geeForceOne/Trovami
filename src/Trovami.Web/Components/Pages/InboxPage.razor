@page "/inbox"
@inherits AppPage
@inject ItemService Items
@inject LocationService Locations
@inject IJSRuntime JS

<PageTitle>Inbox · @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Inbox</h1>
        <p class="page-sub">Items added without a location, usually on the phone. Give each one its place.</p>
    </div>
    <div class="segmented" role="radiogroup" aria-label="Show items as">
        <button type="button" role="radio" class="@(_table ? "" : "on")" aria-checked="@(_table ? "false" : "true")" @onclick="() => SetViewAsync(table: false)"><Icon Name="image" Size="16" /> Photos</button>
        <button type="button" role="radio" class="@(_table ? "on" : "")" aria-checked="@(_table ? "true" : "false")" @onclick="() => SetViewAsync(table: true)"><Icon Name="list" Size="16" /> Table</button>
    </div>
</div>

@if (Household is not null)
{
    <ItemAdd OnAdded="ReloadAllAsync" />
    <NamingWatcher Active="_items.Any(i => i.Naming)" OnTick="LoadAsync" />

    @if (_items.Count > 0)
    {
        <div class="bulk-bar @(_selected.Count > 0 ? "active" : "")">
            <label class="check">
                <input type="checkbox" checked="@(_selected.Count == _items.Count)" @onchange="ToggleAll" />
                @(_selected.Count > 0 ? $"{Format.Number(_selected.Count)} selected" : "Select all")
            </label>
            @if (_selected.Count > 0)
            {
                <LocationPicker Tree="_tree" Placeholder="@($"Move {Format.Count(_selected.Count, "item", "items")} to…")" OnPick="id => MoveAsync(_selected.ToList(), id)" />
                <BulkKeywords Items="_items.Where(i => _selected.Contains(i.Id)).ToList()" />
                <button type="button" class="btn btn-ghost btn-sm btn-danger-text" @onclick="DeleteSelectedAsync"><Icon Name="trash" Size="16" /> Delete</button>
            }
        </div>

        @if (_table)
        {
            @* No scrolling wrapper: it would cut off each row's "Put it in…" list. *@
            <table class="table item-table inbox-table">
                <thead>
                    <tr>
                        <th class="item-table-photo"><span class="visually-hidden">Photo</span></th>
                        <th>Name</th>
                        <th>Keywords</th>
                        <th class="num">Qty</th>
                        <th>Added</th>
                        <th><span class="visually-hidden">Put it in</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        var selected = _selected.Contains(item.Id);
                        <tr @key="item.Id" class="@(selected ? "selected" : "")">
                            <td class="item-table-photo">
                                <a href="@($"i/{item.ShortCode}")" tabindex="-1">
                                    @if (item.PhotoVersion is { } v)
                                    {
                                        <img src="@Format.ItemPhoto(item.Id, v)" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="item-table-nophoto"><Icon Name="@(item.PhotoExpected ? "clock" : "image")" Size="16" /></span>
                                    }
                                </a>
                            </td>
                            <td data-label="Name" class="item-table-name">
                                <label class="check row-check">
                                    <input type="checkbox" checked="@selected" @onchange="e => Select(item.Id, e.Value is true)" aria-label="@($"Select {item.ShownName}")" />
                                    <a href="@($"i/{item.ShortCode}")" class="@(item.Name is null ? "muted" : "")">@(item.Naming ? "Naming…" : item.ShownName)</a>
                                </label>
                            </td>
                            <td data-label="Keywords"><KeywordChips Keywords="item.Keywords" /></td>
                            <td data-label="Qty" class="num">@Format.Number(item.Quantity)</td>
                            <td data-label="Added" class="nowrap">@Format.Ago(item.CreatedAt)</td>
                            <td class="inbox-put">
                                @if (_selected.Count == 0)
                                {
                                    <LocationPicker Tree="_tree" Placeholder="Put it in…" OnPick="id => MoveAsync([item.Id], id)" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="item-grid inbox-grid">
                @foreach (var item in _items)
                {
                    <ItemCard Item="item" ShowKeywords="true" Selected="_selected.Contains(item.Id)" OnSelect="on => Select(item.Id, on)">
                        @if (_selected.Count == 0)
                        {
                            <LocationPicker Tree="_tree" Placeholder="Put it in…" OnPick="id => MoveAsync([item.Id], id)" />
                        }
                    </ItemCard>
                }
            </div>
        }
    }
    else if (_loaded)
    {
        <div class="empty">
            <Icon Name="inbox" Size="32" />
            <p>The Inbox is empty: everything has its place.</p>
        </div>
    }
}

@code {
    private const string ViewPref = "inboxView";

    private bool _loaded;
    private bool _table;
    private IReadOnlyList<ItemView> _items = [];
    private LocationTree _tree = new([]);
    private readonly HashSet<Guid> _selected = [];

    protected override async Task OnInitializedAsync()
    {
        ReloadOnHouseholdChange(LoadAsync);
        await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        if (Household is null) return;
        var userId = await UserIdAsync();
        _items = await Items.InboxAsync(userId, Household.Id, PageToken);
        _tree = await Locations.TreeAsync(userId, Household.Id, PageToken);
        _selected.IntersectWith(_items.Select(i => i.Id));
    }

    // The view is remembered per browser, like a location's (see LocationDetail).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await JS.InvokeAsync<string?>("trovami.getPref", ViewPref) == "table")
        {
            _table = true;
            StateHasChanged();
        }
    }

    private async Task SetViewAsync(bool table)
    {
        if (_table == table) return;
        _table = table;
        await JS.InvokeVoidAsync("trovami.setPref", ViewPref, table ? "table" : "photos");
    }

    // After adding or moving: the Inbox count in the navigation changes too (which reloads this page).
    private Task ReloadAllAsync() => Ui.RefreshAsync();

    private void Select(Guid id, bool on)
    {
        if (on) _selected.Add(id); else _selected.Remove(id);
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (e.Value is true)
            _selected.UnionWith(_items.Select(i => i.Id));
        else
            _selected.Clear();
    }

    private async Task MoveAsync(IReadOnlyCollection<Guid> ids, Guid? locationId)
    {
        if (locationId is null) return;
        if (await RunAsync(async () => await Items.MoveAsync(await UserIdAsync(), ids, locationId, PageToken)))
        {
            Ui.Toast.Success($"{Format.Count(ids.Count, "item", "items")} moved to {_tree.PathOf(locationId)}.");
            _selected.ExceptWith(ids);
            await ReloadAllAsync();
        }
    }

    private async Task DeleteSelectedAsync()
    {
        var ids = _selected.ToList();
        if (!await Ui.Confirm.AskAsync($"Delete {Format.Count(ids.Count, "item", "items")}?", "They're removed with their photos for everyone in the household.", "Delete", danger: true))
            return;
        if (await RunAsync(async () => await Items.DeleteAsync(await UserIdAsync(), ids, PageToken)))
        {
            _selected.Clear();
            await ReloadAllAsync();
        }
    }
}
