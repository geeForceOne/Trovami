@page "/"
@page "/l/{Key}"
@page "/k"
@page "/k/{Word}"
@inherits AppPage
@inject HouseholdService Households
@inject LocationService Locations
@inject ItemService Items
@inject IJSRuntime JS

@* The location tree on the left and the picked location on the right. Both routes use this one
   page, so the tree keeps what's open while moving between locations. Under the tree, the most
   used keywords (all of them at /k): a picked one shows its items on the right. On phones it's
   one column: the tree, or the picked location or keyword with a way back. Coming to the page without
   a location opens the last one picked, per browser and household; the links inside the page still
   lead back to the overview. *@
<PageTitle>@(Word is not null ? Word : AllKeywords ? "Keywords" : Id is not null && _tree.Find(Id) is { } shown ? shown.Name : "Inventory") · @AppInfo.Name</PageTitle>

@if (!_loaded)
{
    <p class="page-loading">…</p>
}
else if (Household is null)
{
    <div class="welcome">
        <BrandMark Size="72" PlayOnLoad="true" />
        <h1>@($"Welcome to {AppInfo.Name}")</h1>
        <p class="page-sub">Everything you store belongs to a household: your home, a cellar, a holiday flat. Start with one; you can invite others into it later.</p>
        <form class="inline-add" @onsubmit="CreateHouseholdAsync" @onsubmit:preventDefault="true">
            <input data-bwignore="true" class="input input-lg" @bind="_householdName" @bind:event="oninput" placeholder="Name, e.g. Home" maxlength="@Trovami.Core.Models.Household.MaxNameLength" aria-label="Household name" />
            <button type="submit" class="btn btn-primary btn-lg" disabled="@(Busy || string.IsNullOrWhiteSpace(_householdName))">Create household</button>
        </form>
        @if (Ui.Invites.Count > 0)
        {
            <p class="muted">Or accept an invite above.</p>
        }
    </div>
}
else
{
    <div class="loc-split @(Id is null && Word is null && !AllKeywords ? "" : "has-selection")">
        <aside class="loc-nav" aria-label="Locations">
            <div class="loc-nav-head">
                <h1>Locations</h1>
                @if (_tree.Count > 0)
                {
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="ToggleAll">@(_expanded.Count > 0 ? "Collapse all" : "Expand all")</button>
                }
            </div>
            @if (_tree.Count > 0)
            {
                <ul class="tree" role="tree">
                    @foreach (var node in _tree.ChildrenOf(null))
                    {
                        @RenderNode(node)
                    }
                </ul>
            }
            <button type="button" class="btn btn-secondary loc-new" @onclick="NewLocationAsync"><Icon Name="plus" Size="16" /> New location</button>

            @if (_keywords.Count > 0)
            {
                <div class="loc-nav-head keyword-head">
                    <button type="button" class="tree-toggle" aria-expanded="@(_keywordsOpen ? "true" : "false")" aria-controls="keyword-list" @onclick="() => _keywordsOpen = !_keywordsOpen">
                        <Icon Name="@(_keywordsOpen ? "down" : "right")" Size="14" />
                    </button>
                    <h2>Keywords</h2>
                    <span class="tree-count">@Format.Number(_keywords.Count)</span>
                </div>
                @if (_keywordsOpen)
                {
                    <ul class="tree keyword-list" id="keyword-list">
                        @foreach (var k in TopKeywords())
                        {
                            var selected = k.Keyword == Word;
                            <li>
                                <div class="tree-row @(selected ? "on" : "")">
                                    <a class="tree-link" href="@KeywordDetail.KeywordLink(k.Keyword)" aria-current="@(selected ? "page" : null)">
                                        <span class="tree-name keyword-name">@k.Keyword</span>
                                        @if (k.Color is not null)
                                        {
                                            <span class="keyword-dot" style="@Format.ColorVar(k.Color)"></span>
                                        }
                                        @if (k.Pinned)
                                        {
                                            <span class="keyword-pin" title="Pinned"><Icon Name="pin" Size="12" /></span>
                                        }
                                    </a>
                                    <span class="tree-count">@Format.Number(k.Items)</span>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="keyword-all @(AllKeywords ? "on" : "")" href="k">@(_keywords.Count > TopKeywordCount ? $"All {Format.Number(_keywords.Count)} keywords" : "Tidy up keywords") <Icon Name="right" Size="14" /></a>
                }
            }
        </aside>

        <section class="loc-pane">
            @if (AllKeywords)
            {
                <KeywordList Keywords="_keywords" />
            }
            else if (Word is not null)
            {
                <KeywordDetail Keyword="@Word" Tree="_tree" Keywords="_keywords" />
            }
            else if (Id is { } id)
            {
                <LocationDetail Id="id" Tree="_tree" OnChanged="ReloadAsync" />
            }
            else
            {
                <div class="page-head">
                    <div>
                        <h2>@Household.Name</h2>
                        <p class="page-sub">@(_tree.Count == 0 ? $"Where things are stored in {Household.Name}." : $"{Format.Count(_tree.Count, "location", "locations")} and {Format.Count(_tree.All.Sum(n => n.Items), "item", "items")}.")</p>
                    </div>
                </div>
                @if (Ui.InboxCount > 0)
                {
                    <a class="inbox-strip" href="inbox">
                        <Icon Name="inbox" />
                        <span>@($"{Format.Count(Ui.InboxCount, "item waits", "items wait")} in the Inbox for a location.")</span>
                        <Icon Name="right" Size="16" />
                    </a>
                }
                <div class="empty">
                    @if (_tree.Count == 0)
                    {
                        <Icon Name="house" Size="32" />
                        <p>Start with the place itself, like "House" or "Apartment". Rooms, closets and boxes go inside it.</p>
                        <button type="button" class="btn btn-primary" @onclick="NewLocationAsync"><Icon Name="plus" Size="16" /> New location</button>
                    }
                    else
                    {
                        <Icon Name="left" Size="32" />
                        <p>Pick a location to see what's in it and to add items.</p>
                    }
                </div>
            }
        </section>
    </div>
}

<LocationDialog @ref="_newDialog" />

@code {
    // The picked location's short code; an old /l/<guid> link is taken there too.
    [Parameter] public string? Key { get; set; }

    // The picked keyword, from /k/<keyword>.
    [Parameter] public string? Word { get; set; }

    // The tree shows only this many keywords, the most used; /k lists them all.
    private const int TopKeywordCount = 12;

    private bool AllKeywords => Word is null && Key is null && Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == "k";

    // The most used, A to Z, plus the pinned ones (phones have no side menu to show them in) and the
    // picked one when they aren't among them.
    private IEnumerable<KeywordCount> TopKeywords() => _keywords
        .OrderByDescending(k => k.Items).ThenBy(k => k.Keyword, StringComparer.CurrentCultureIgnoreCase)
        .Take(TopKeywordCount)
        .Concat(_keywords.Where(k => k.Pinned || k.Keyword == Word))
        .DistinctBy(k => k.Keyword)
        .OrderBy(k => k.Keyword, StringComparer.CurrentCultureIgnoreCase);

    // Guid.Empty for a code that isn't in the tree: the pane says it no longer exists.
    private Guid? Id => Key is null ? null
        : Guid.TryParse(Key, out var id) ? id
        : _tree.FindByCode(Key)?.Id ?? Guid.Empty;

    private bool _loaded;
    private string _householdName = "Home";
    private LocationTree _tree = new([]);
    private readonly HashSet<Guid> _expanded = [];
    private IReadOnlyList<KeywordCount> _keywords = [];
    private bool _keywordsOpen = true;
    private LocationDialog _newDialog = default!;
    private const string LastLocationPref = "lastLocation.";
    private Guid? _rememberedId;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ReloadOnHouseholdChange(async () =>
        {
            await ReloadAsync();
            // Switched to another household: the picked location isn't in it.
            if (Id is { } id && !_tree.Contains(id))
                Nav.NavigateTo(await LastLocationLinkAsync() ?? "");
        });
        await ReloadAsync();
        // The first two levels open, so the rooms show right away.
        foreach (var top in _tree.ChildrenOf(null))
            _expanded.Add(top.Id);
        if (Key is null && Word is null && !AllKeywords && await LastLocationLinkAsync() is { } last)
            Nav.NavigateTo(last, replace: true);
        _loaded = true;
    }

    // Between / and /k no route parameter changes, so Blazor wouldn't render the page again by itself.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Household is { } h && _tree.Find(Id) is { } node && node.Id != _rememberedId)
        {
            _rememberedId = node.Id;
            await JS.InvokeVoidAsync("trovami.setPref", LastLocationPref + h.Id, node.ShortCode);
        }
    }

    // Null when nothing was picked in this household yet, or that location is gone.
    private async Task<string?> LastLocationLinkAsync()
    {
        if (Household is not { } h) return null;
        var code = await JS.InvokeAsync<string?>("trovami.getPref", LastLocationPref + h.Id);
        return code is not null && _tree.FindByCode(code) is { } node ? $"l/{node.ShortCode}" : null;
    }

    protected override void OnParametersSet()
    {
        if (Key is not null && (_tree.Find(Id) is { } node) && node.ShortCode != Key)
            Nav.NavigateTo($"l/{node.ShortCode}", replace: true);
        OpenToSelected();
    }

    // The picked location stays in sight: the way to it is open, also after it moved.
    private void OpenToSelected()
    {
        if (Id is { } id && _tree.Contains(id))
            foreach (var a in _tree.Ancestry(id))
                _expanded.Add(a.Id);
    }

    private async Task ReloadAsync()
    {
        var userId = await UserIdAsync();
        _tree = Household is { } h ? await Locations.TreeAsync(userId, h.Id, PageToken) : new([]);
        _keywords = Household is { } k ? await Items.KeywordsAsync(userId, k.Id, PageToken) : [];
        OpenToSelected();
    }

    private RenderFragment RenderNode(LocationNode node) => __builder =>
    {
        var children = _tree.ChildrenOf(node.Id).ToList();
        var open = _expanded.Contains(node.Id);
        var selected = node.Id == Id;
        var below = _tree.ItemsBelow(node.Id);
        <li role="treeitem" aria-selected="@(selected ? "true" : "false")" aria-expanded="@(children.Count > 0 ? (open ? "true" : "false") : null)">
            <div class="tree-row @(selected ? "on" : "")" style="@Format.ColorVar(node.Color)">
                @if (children.Count > 0)
                {
                    <button type="button" class="tree-toggle" aria-label="@(open ? "Collapse" : "Expand")" @onclick="() => Toggle(node.Id)">
                        <Icon Name="@(open ? "down" : "right")" Size="14" />
                    </button>
                }
                else
                {
                    <span class="tree-toggle"></span>
                }
                <a class="tree-link" href="@($"l/{node.ShortCode}")" aria-current="@(selected ? "page" : null)">
                    <span class="loc-icon @(node.Color is null ? "" : "colored")"><Icon Name="@Format.KindIcon(node.Kind)" Size="18" /></span>
                    <span class="tree-name">@node.Name</span>
                    @if (node.Label is not null)
                    {
                        <span class="label-chip">@node.Label</span>
                    }
                </a>
                <span class="tree-count">@(below > 0 ? Format.Number(below) : "")</span>
            </div>
            @if (open && children.Count > 0)
            {
                <ul role="group">
                    @foreach (var child in children)
                    {
                        @RenderNode(child)
                    }
                </ul>
            }
        </li>
    };

    private void Toggle(Guid id)
    {
        if (!_expanded.Remove(id))
            _expanded.Add(id);
    }

    private void ToggleAll()
    {
        if (_expanded.Count > 0)
            _expanded.Clear();
        else
            foreach (var n in _tree.All.Where(n => _tree.ChildrenOf(n.Id).Any()))
                _expanded.Add(n.Id);
    }

    // New locations go inside the one that's picked; the dialog can change that. The page stays where
    // it is, with the way to the new location open in the tree.
    private async Task NewLocationAsync()
    {
        if (Household is null) return;
        var parent = Id is { } id && _tree.Contains(id) ? id : (Guid?)null;
        await _newDialog.AskAsync(() => _tree, parent, CreateAsync, Ui.LastLocationKind);
        Ui.LastLocationKind = _newDialog.LastKind;
    }

    private async Task<Guid?> CreateAsync(LocationDialog.Fields loc)
    {
        Guid? id = null;
        await RunAsync(async () =>
        {
            var userId = await UserIdAsync();
            var newId = await Locations.CreateAsync(userId, Household!.Id, loc.ParentId, loc.Name, loc.Kind, ct: PageToken);
            id = newId;
            if (loc.Label is not null || loc.Color is not null || loc.Notes is not null || loc.Keywords.Count > 0)
                await Locations.UpdateAsync(userId, newId, new LocationUpdate(loc.Name, loc.Kind, loc.Notes, loc.Color, loc.Label, loc.Keywords), PageToken);
        });
        if (id is { } created)
        {
            // Its own step: a photo that can't be read shows an error, and the location is still there.
            if (loc.Photo is { } photo)
                await RunAsync(async () =>
                {
                    await using var stream = photo.OpenReadStream(Trovami.Core.Photos.PhotoStore.MaxUploadBytes, PageToken);
                    await Locations.SetPhotoAsync(await UserIdAsync(), created, stream, PageToken);
                });
            await ReloadAsync();
            if (loc.ParentId is { } p)
                foreach (var a in _tree.Ancestry(p))
                    _expanded.Add(a.Id);
            Ui.Toast.Success($"{loc.Name} added.");
            StateHasChanged();
        }
        return id;
    }

    private async Task CreateHouseholdAsync()
    {
        await RunAsync(async () =>
        {
            await Households.CreateAsync(await UserIdAsync(), _householdName, PageToken);
            await Ui.RefreshAsync();
        });
    }
}
