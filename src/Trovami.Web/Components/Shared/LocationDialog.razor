@* The one form for a new location and for editing one. The page passes in the save step; it shows
   errors itself and returns the id, or null when it didn't work. A new location gets its keywords and
   photo with Save, as it doesn't exist before that; when editing they save as they change, through
   EditSteps. "Save and add another" keeps the dialog open with the same parent, kind and color. *@
@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="new-location-title" @onkeydown="OnKeyDown">
            <h2 id="new-location-title">@(_steps is null ? "New location" : "Edit location")</h2>
            <form class="form" @onsubmit="() => SubmitAsync(another: false)" @onsubmit:preventDefault="true">
                <div class="field-row field-row-wrap">
                    <label class="field field-grow">
                        <span>Name</span>
                        <input data-bwignore="true" class="input" @bind="_name" @bind:event="oninput" @ref="_nameInput" maxlength="@Location.MaxNameLength" autocomplete="off" />
                    </label>
                    <label class="field">
                        <span>Kind</span>
                        <KindSelect @bind-Value="_kind" />
                    </label>
                </div>
                <div class="field">
                    <span>Inside</span>
                    @if (_picking)
                    {
                        <div class="new-loc-parent">
                            <LocationPicker Tree="_tree" Exclude="_editId" Current="_parentId" AutoFocus="true" Placeholder="Pick a location…" OnPick="PickParent" />
                            @if (_parentId is not null)
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => PickParent(null)">Top level</button>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _picking = false">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="new-loc-parent">
                            <span class="new-loc-path">@(_parentId is null ? "Top level" : _tree.PathOf(_parentId))</span>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _picking = true">Change</button>
                        </div>
                    }
                </div>
                <label class="field">
                    <span>Label <span class="muted">(what's written on it)</span></span>
                    <input data-bwignore="true" class="input input-short input-code" @bind="_label" @bind:event="oninput" maxlength="@Location.MaxLabelLength" placeholder="B12" autocomplete="off" />
                </label>
                <div class="field">
                    <span>Color</span>
                    <ColorPicker @bind-Value="_color" />
                </div>
                <label class="field">
                    <span>Notes <span class="muted">(an address, opening times, what's special)</span></span>
                    <textarea data-bwignore="true" class="textarea" rows="3" @bind="_notes" @bind:event="oninput" maxlength="@Location.MaxNotesLength"></textarea>
                </label>
                <div class="field">
                    <label for="location-keywords">Keywords</label>
                    <KeywordEditor Keywords="_keywords" Save="SaveKeywordsAsync" @bind-Typed="_typedKeyword" InputId="location-keywords" />
                    <span class="field-hint">
                        Items that arrive here or anywhere below get these. Items already here don't change. Separate them with a comma.@(_steps is null ? "" : " They save right away.")
                        @if (_tree.KeywordsFor(_parentId) is { Count: > 0 } above)
                        {
                            <text> From the locations above, they also get: @string.Join(", ", above).</text>
                        }
                    </span>
                </div>
                <div class="field">
                    <span>Photo</span>
                    <div class="actions">
                        <PhotoButton Label="@(_hasPhoto || _photo is not null ? "Replace photo" : "Add photo")" OnPhoto="PickPhotoAsync" Disabled="_busy" />
                        @if (_photo is not null)
                        {
                            <span class="muted small">@_photo.Name</span>
                        }
                        @if (_hasPhoto || _photo is not null)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_busy" @onclick="RemovePhotoAsync">Remove photo</button>
                        }
                    </div>
                </div>
                @if (_added > 0)
                {
                    <p class="muted small">@($"{Format.Count(_added, "location", "locations")} added so far.")</p>
                }
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="Close">@(_added > 0 ? "Done" : "Cancel")</button>
                    @if (_steps is null)
                    {
                        <button type="button" class="btn btn-secondary" disabled="@(!CanSave)" @onclick="() => SubmitAsync(another: true)">Save and add another</button>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@(!CanSave)">Save</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record Fields(Guid? ParentId, string Name, LocationKind Kind, string? Label, string? Color, string? Notes, IReadOnlyList<string> Keywords, IBrowserFile? Photo);

    // What saves at once while editing. The photo steps return false when they didn't work.
    public sealed record EditSteps(Func<List<string>, Task> SaveKeywords, Func<IBrowserFile, Task<bool>> SetPhoto, Func<Task<bool>> RemovePhoto);

    private EditSteps? _steps;
    private Guid? _editId;
    private bool _visible;
    private bool _focusPending;
    private bool _busy;
    private bool _picking;
    private LocationTree _tree = new([]);
    private Guid? _parentId;
    private string _name = "";
    private LocationKind _kind;
    private string? _label;
    private string? _color;
    private string? _notes;
    private List<string> _keywords = [];
    private string _typedKeyword = "";
    // Editing: the location has a photo. New: the one picked, read when saving.
    private bool _hasPhoto;
    private IBrowserFile? _photo;
    private int _added;
    private Guid? _lastId;
    private Func<Fields, Task<Guid?>> _create = default!;
    private Func<LocationTree> _currentTree = default!;
    private ElementReference _nameInput;
    private TaskCompletionSource<Guid?>? _tcs;

    private bool CanSave => !_busy && !_picking && !string.IsNullOrWhiteSpace(_name);

    // Resolves to the last location created, or null if none was. currentTree: the page's tree,
    // read again after each save so a location just added can be the next parent.
    public Task<Guid?> AskAsync(Func<LocationTree> currentTree, Guid? parentId, Func<Fields, Task<Guid?>> create)
    {
        var tree = currentTree();
        var kind = parentId is null ? (tree.Count == 0 ? LocationKind.House : LocationKind.Room) : KindSelect.ChildKind(tree.Find(parentId)!.Kind);
        return Open(null, null, currentTree, create, parentId, "", kind, null, null, null, [], false);
    }

    // The same form filled in with a location; resolves when it closes.
    public Task<Guid?> EditAsync(LocationTree tree, LocationNode node, Func<Fields, Task<Guid?>> save, EditSteps steps) =>
        Open(steps, node.Id, () => tree, save, node.ParentId, node.Name, node.Kind, node.Label, node.Color, node.Notes, node.Keywords.ToList(), node.PhotoVersion is not null);

    private Task<Guid?> Open(EditSteps? steps, Guid? editId, Func<LocationTree> currentTree, Func<Fields, Task<Guid?>> save, Guid? parentId,
        string name, LocationKind kind, string? label, string? color, string? notes, List<string> keywords, bool hasPhoto)
    {
        _tcs?.TrySetResult(null);
        _steps = steps;
        _editId = editId;
        _currentTree = currentTree;
        _tree = currentTree();
        _create = save;
        _parentId = parentId;
        _name = name;
        _kind = kind;
        _label = label;
        _color = color;
        _notes = notes;
        _keywords = keywords;
        _typedKeyword = "";
        _hasPhoto = hasPhoto;
        _photo = null;
        _added = 0;
        _lastId = null;
        _picking = false;
        _busy = false;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<Guid?>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _nameInput.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_picking) Close();
    }

    private void PickParent(Guid? id)
    {
        _parentId = id;
        _picking = false;
        if (_steps is null)
            _kind = id is null ? LocationKind.Room : KindSelect.ChildKind(_tree.Find(id)!.Kind);
        _focusPending = true;
    }

    private async Task SaveKeywordsAsync(List<string> keywords)
    {
        _keywords = keywords;
        if (_steps is not null)
            await _steps.SaveKeywords(keywords);
        StateHasChanged();
    }

    private async Task PickPhotoAsync(IBrowserFile file)
    {
        if (_steps is null)
        {
            _photo = file;
            return;
        }
        _busy = true;
        try
        {
            if (await _steps.SetPhoto(file))
                _hasPhoto = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemovePhotoAsync()
    {
        if (_steps is null)
        {
            _photo = null;
            return;
        }
        _busy = true;
        try
        {
            if (await _steps.RemovePhoto())
                _hasPhoto = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitAsync(bool another)
    {
        if (!CanSave) return;
        _busy = true;
        Guid? id;
        try
        {
            var notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();
            id = await _create(new Fields(_parentId, _name.Trim(), _kind, string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(), _color, notes,
                ItemKeywords.Clean(_keywords.Append(_typedKeyword)), _photo));
        }
        finally
        {
            _busy = false;
        }
        if (id is null)
            return;
        _lastId = id;
        _added++;
        if (!another)
        {
            Close();
            return;
        }
        _tree = _currentTree();
        _name = "";
        _label = null;
        _notes = null;
        _keywords = [];
        _typedKeyword = "";
        _photo = null;
        _focusPending = true;
        StateHasChanged();
    }

    private void Close()
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(_lastId);
    }
}
