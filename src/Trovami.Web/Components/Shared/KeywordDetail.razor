@inherits AppPage
@inject ItemService Items
@inject IJSRuntime JS

@* The right pane of the Locations page for a keyword: the items that have it, from anywhere, with all
   their keywords to take off right there, its color and pin, and ways to tidy it up across all of them.
   Changes reload the layout's and the page's keywords through Ui.RefreshAsync. *@
<a class="loc-back" href="k"><Icon Name="left" Size="16" /> All keywords</a>

<div class="loc-head" style="@Format.ColorVar(Current?.Color)">
    <span class="loc-icon loc-icon-lg @(Current?.Color is null ? "" : "colored")"><Icon Name="tag" Size="28" /></span>
    <div class="loc-title">
        <h1>@Keyword</h1>
        <p class="page-sub">Keyword · @Format.Count(_items.Count, "item", "items")</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-secondary btn-sm" disabled="@Busy" aria-pressed="@(Pinned ? "true" : "false")" title="Pinned keywords show in the menu, also without items" @onclick="TogglePinAsync"><Icon Name="pin" Size="16" /> @(Pinned ? "Unpin" : "Pin")</button>
        @if (_items.Count > 0 || Pinned)
        {
            <button type="button" class="btn btn-ghost btn-sm" disabled="@Busy" @onclick="RenameAsync"><Icon Name="edit" Size="16" /> Rename</button>
        }
        @if (_items.Count > 0)
        {
            <button type="button" class="btn btn-ghost btn-sm" aria-expanded="@(_merging ? "true" : "false")" @onclick="() => _merging = !_merging"><Icon Name="move" Size="16" /> Merge into…</button>
            <button type="button" class="btn btn-ghost btn-sm btn-danger-text" disabled="@Busy" @onclick="RemoveAsync"><Icon Name="trash" Size="16" /> Remove</button>
        }
    </div>
</div>

<div class="field keyword-color">
    <span>Color</span>
    <ColorPicker Value="@Current?.Color" ValueChanged="SetColorAsync" Disabled="Busy" />
</div>

@if (_merging)
{
    var others = Keywords.Where(k => k.Keyword != Keyword).ToList();
    <div class="inline-panel">
        @if (others.Count == 0)
        {
            <span>There's no other keyword to merge it into.</span>
        }
        else
        {
            <span>@($"Replace \"{Keyword}\" on its items with:")</span>
            <div class="chips keyword-targets">
                @foreach (var k in others)
                {
                    <button type="button" class="chip" disabled="@Busy" @onclick="() => MergeAsync(k.Keyword)">@k.Keyword</button>
                }
            </div>
        }
    </div>
}

@if (!_loaded)
{
    <p class="page-loading">…</p>
}
else if (_items.Count == 0)
{
    <div class="empty">
        <Icon Name="tag" Size="32" />
        <p>@(Pinned ? "No item has this keyword right now. It stays here because it's pinned." : "No item has this keyword anymore.")</p>
    </div>
}
else
{
    <div class="keyword-view">
        <div class="segmented" role="radiogroup" aria-label="Show items as">
            <button type="button" role="radio" class="@(_table ? "" : "on")" aria-checked="@(_table ? "false" : "true")" @onclick="() => SetViewAsync(table: false)"><Icon Name="image" Size="16" /> Photos</button>
            <button type="button" role="radio" class="@(_table ? "on" : "")" aria-checked="@(_table ? "true" : "false")" @onclick="() => SetViewAsync(table: true)"><Icon Name="list" Size="16" /> Table</button>
        </div>
    </div>
    <ItemTable Items="_items" Tree="Tree" LocationId="null" Photos="!_table" BulkKeywords="true" RemoveKeyword="RemoveFromItemAsync" Scope="@Keyword" />
}

@code {
    [Parameter, EditorRequired] public string Keyword { get; set; } = "";
    [Parameter, EditorRequired] public LocationTree Tree { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<KeywordCount> Keywords { get; set; } = [];

    private const string ViewPref = "keywordView";

    private IReadOnlyList<ItemView> _items = [];
    private bool _loaded;
    // The table (with each item's keywords to take off) unless Photos was picked, remembered per browser.
    private bool _table = true;
    private bool _merging;
    private string? _shown;

    private KeywordCount? Current => Keywords.FirstOrDefault(k => k.Keyword == Keyword);
    private bool Pinned => Current?.Pinned == true;

    protected override async Task OnParametersSetAsync()
    {
        if (_shown != Keyword)
        {
            _shown = Keyword;
            _merging = false;
        }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await JS.InvokeAsync<string?>("trovami.getPref", ViewPref) == "photos")
        {
            _table = false;
            StateHasChanged();
        }
    }

    private async Task SetViewAsync(bool table)
    {
        if (_table == table) return;
        _table = table;
        await JS.InvokeVoidAsync("trovami.setPref", ViewPref, table ? "table" : "photos");
    }

    private async Task LoadAsync()
    {
        if (Household is null) return;
        _items = await Items.WithKeywordAsync(await UserIdAsync(), Household.Id, Keyword, PageToken);
        _loaded = true;
    }

    private async Task SetColorAsync(string? color)
    {
        if (Household is null) return;
        if (await RunAsync(async () => await Items.SetKeywordColorAsync(await UserIdAsync(), Household.Id, Keyword, color, PageToken)))
            await Ui.RefreshAsync();
    }

    private async Task TogglePinAsync()
    {
        if (Household is null) return;
        var pinned = !Pinned;
        if (await RunAsync(async () => await Items.SetKeywordPinnedAsync(await UserIdAsync(), Household.Id, Keyword, pinned, PageToken)))
            await Ui.RefreshAsync();
    }

    // The x on a keyword in the table: takes it off that one item.
    private async Task RemoveFromItemAsync(ItemView item, string word)
    {
        if (await TryAsync(async () => await Items.SetKeywordsAsync(await UserIdAsync(), item.Id, item.Keywords.Where(k => k != word).ToList(), PageToken)))
        {
            await LoadAsync();
            await Ui.RefreshAsync();
        }
        StateHasChanged();
    }

    // Renaming to a keyword that exists merges the two, the same as "Merge into…".
    private async Task RenameAsync()
    {
        var name = await Ui.Prompt.AskAsync($"Rename \"{Keyword}\"", "New keyword", Keyword, "Rename",
            hint: $"Changes it on {Format.Count(_items.Count, "item", "items")} and on locations that add it. A keyword that already exists merges with it.");
        if (string.IsNullOrWhiteSpace(name) || ItemKeywords.Clean([name]).FirstOrDefault() is not { } clean || clean == Keyword)
            return;
        await ReplaceAsync(clean, $"Renamed to \"{clean}\".");
    }

    private Task MergeAsync(string into) => ReplaceAsync(into, $"Merged into \"{into}\".");

    private async Task RemoveAsync()
    {
        var pinned = Pinned ? " It stays pinned, until you unpin it." : "";
        if (!await Ui.Confirm.AskAsync($"Remove \"{Keyword}\"?", $"It's taken off {Format.Count(_items.Count, "item", "items")} and off locations that add it. The items stay.{pinned}", "Remove", danger: true))
            return;
        await ReplaceAsync(null, $"Removed \"{Keyword}\".");
    }

    private async Task ReplaceAsync(string? newKeyword, string done)
    {
        if (Household is null) return;
        var stays = newKeyword is null && Pinned;
        if (await RunAsync(async () => await Items.ReplaceKeywordAsync(await UserIdAsync(), Household.Id, Keyword, newKeyword, PageToken)))
        {
            Ui.Toast.Success(done);
            await Ui.RefreshAsync();
            if (!stays)
                Nav.NavigateTo(newKeyword is null ? "" : KeywordLink(newKeyword));
        }
    }

    public static string KeywordLink(string keyword) => $"k/{Uri.EscapeDataString(keyword)}";
}
