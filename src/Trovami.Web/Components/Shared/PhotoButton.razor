@* A button that opens the file picker (or the camera on a phone) for photos. Multiple: several
   at once, each handed to OnPhoto in turn. *@
<label class="btn btn-secondary btn-sm photo-button @(Disabled ? "disabled" : "")">
    <Icon Name="camera" Size="16" /> @Label
    <InputFile class="visually-hidden" accept="image/*" multiple="@Multiple" disabled="@Disabled" OnChange="OnChangeAsync" />
</label>

@code {
    [Parameter] public string Label { get; set; } = "Add photo";
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<IBrowserFile> OnPhoto { get; set; }

    private const int MaxFiles = 50;

    private async Task OnChangeAsync(InputFileChangeEventArgs e)
    {
        var files = Multiple ? e.GetMultipleFiles(MaxFiles) : [e.File];
        foreach (var file in files)
            await OnPhoto.InvokeAsync(file);
    }
}
