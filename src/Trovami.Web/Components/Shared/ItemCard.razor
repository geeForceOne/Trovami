@* An item in a grid: its photo, name and quantity; opens the item. Select shows a checkbox for
   picking several, ShowKeywords its first keywords (in the Inbox and a keyword's list). *@
<div class="item-card @(Selected ? "selected" : "")">
    <a class="item-link" href="@($"i/{Item.ShortCode}")">
        <span class="item-photo">
            @if (Item.PhotoVersion is { } v)
            {
                <img src="@Format.ItemPhoto(Item.Id, v)" alt="" loading="lazy" />
            }
            else
            {
                <span class="item-nophoto"><Icon Name="@(Item.PhotoExpected ? "clock" : "image")" Size="28" /></span>
            }
            @if (Item.Quantity > 1)
            {
                <span class="item-qty">@($"× {Format.Number(Item.Quantity)}")</span>
            }
        </span>
        <span class="item-name @(Item.Name is null ? "unnamed" : "")">
            @if (Item.Naming)
            {
                <span class="naming"><BrandMark Size="14" Busy="true" /> Naming…</span>
            }
            else
            {
                @Item.ShownName
            }
        </span>
        @if (ShowPath || !string.IsNullOrEmpty(PathText))
        {
            <span class="item-path">@(PathText ?? Item.Path)</span>
        }
        @if (ShowKeywords && Item.Keywords.Count > 0)
        {
            <span class="item-keywords"><KeywordChips Keywords="Item.Keywords" /></span>
        }
    </a>
    @if (OnSelect.HasDelegate)
    {
        <label class="item-check" title="Select">
            <input type="checkbox" checked="@Selected" @onchange="e => OnSelect.InvokeAsync(e.Value is true)" aria-label="@($"Select {Item.ShownName}")" />
        </label>
    }
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public ItemView Item { get; set; } = default!;
    [Parameter] public bool ShowPath { get; set; }

    // Shown instead of the full path, e.g. the path below the location being looked at.
    [Parameter] public string? PathText { get; set; }
    [Parameter] public bool ShowKeywords { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback<bool> OnSelect { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
