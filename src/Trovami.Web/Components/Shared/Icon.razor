@* Line icons on a 24 px grid, drawn with the current text color. *@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "mail": <rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /> break;
        case "settings": <circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M2 12h3M19 12h3M4.9 19.1L7 17M17 7l2.1-2.1" /> break;
        case "sliders": <path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /> break;
        case "users": <circle cx="9" cy="8" r="3.5" /><path d="M3 20a6 6 0 0 1 12 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6 6 0 0 1 3 5.5" /> break;
        case "user": <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /> break;
        case "archive": <rect x="3" y="4" width="18" height="5" rx="1" /><path d="M5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9M10 13h4" /> break;
        case "file": <path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V7zM14 3v4h4" /> break;
        case "logout": <path d="M15 4h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4M10 16l-4-4 4-4M6 12h10" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "minus": <path d="M5 12h14" /> break;
        case "edit": <path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4" /> break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-12M9 7V4h6v3" /> break;
        case "check": <path d="M5 12.5l4.5 4.5L19 7" /> break;
        case "x": <path d="M6 6l12 12M18 6L6 18" /> break;
        case "left": <path d="M15 5l-7 7 7 7" /> break;
        case "right": <path d="M9 5l7 7-7 7" /> break;
        case "down": <path d="M5 9l7 7 7-7" /> break;
        case "up": <path d="M5 15l7-7 7 7" /> break;
        case "chevrons": <path d="M8 9l4-4 4 4M8 15l4 4 4-4" /> break;
        case "upload": <path d="M12 16V4M7 9l5-5 5 5M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" /> break;
        case "download": <path d="M12 4v12M7 11l5 5 5-5M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2" /> break;
        case "more": <circle cx="5" cy="12" r="1.2" /><circle cx="12" cy="12" r="1.2" /><circle cx="19" cy="12" r="1.2" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "calendar": <rect x="3" y="5" width="18" height="16" rx="1.5" /><path d="M3 10h18M8 3v4M16 3v4" /> break;
        case "pause": <path d="M9 5v14M15 5v14" /> break;
        case "play": <path d="M8 5v14l11-7z" /> break;
        case "send": <path d="M21 3L10 14M21 3l-7 18-4-7-7-4z" /> break;
        case "key": <circle cx="8" cy="15" r="4" /><path d="M11 12l9-9M17 6l3 3M14 9l2 2" /> break;
        case "info": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.5" /> break;
        case "alert": <path d="M12 3l10 18H2zM12 10v5M12 18v.5" /> break;
        case "restore": <path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v5h5" /> break;
        case "bell": <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15zM10 21h4" /> break;
        case "bell-on": <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15z" fill="currentColor" /><path d="M10 21h4" /> break;
        case "copy": <rect x="8" y="8" width="12" height="12" rx="1.5" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /> break;
        @* Account icons (AccountIcons). *@
        case "inbox": <path d="M3 13l2.5-7.5A1 1 0 0 1 6.4 5h11.2a1 1 0 0 1 .9.5L21 13v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM3 13h5l1.5 2.5h5L16 13h5" /> break;
        case "qr": <rect x="3.5" y="3.5" width="6.5" height="6.5" rx=".8" /><rect x="14" y="3.5" width="6.5" height="6.5" rx=".8" /><rect x="3.5" y="14" width="6.5" height="6.5" rx=".8" /><path d="M14 14h2.5v2.5H14zM18 18h2.5v2.5H18zM14 20.5h2M20.5 14v2" /> break;
        case "nfc": <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9.5 9a4 4 0 0 1 0 6M12.5 7.5a6.5 6.5 0 0 1 0 9" /> break;
        case "tag": <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z" /><circle cx="7.5" cy="7.5" r="1.4" /> break;
        case "move": <path d="M12 3v18M3 12h18M12 3l-3 3M12 3l3 3M12 21l-3-3M12 21l3-3M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3" /> break;
        case "camera": <path d="M4 8h3l1.5-2.5h7L17 8h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" /><circle cx="12" cy="13.5" r="3.5" /> break;
        case "list": <path d="M9 6h11M9 12h11M9 18h11" /><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" stroke-width="2.6" /> break;
        case "image": <rect x="3" y="4" width="18" height="16" rx="1.5" /><circle cx="9" cy="9.5" r="1.8" /><path d="M3.5 18l5.5-5 4 3.5 3-2.5 4.5 4" /> break;
        case "pin": <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /> break;
        case "phone": <rect x="6.5" y="2.5" width="11" height="19" rx="2" /><path d="M10.5 18.5h3" /> break;
        case "print": <path d="M7 9V3h10v6M7 17H4a1 1 0 0 1-1-1v-6a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-3" /><rect x="7" y="14" width="10" height="7" /> break;
        case "apartment": <rect x="5" y="3" width="14" height="18" rx="1" /><path d="M9 7h1.5M13.5 7H15M9 11h1.5M13.5 11H15M9 15h1.5M13.5 15H15M10.5 21v-3h3v3" /> break;
        case "floor": <path d="M12 3l9 4.5-9 4.5-9-4.5zM3 12l9 4.5 9-4.5M3 16.5L12 21l9-4.5" /> break;
        case "room": <path d="M4 20V4h12v16M4 20h16M13 12h.5" /><path d="M16 4l4 1.5V20" /> break;
        case "cellar": <path d="M3 10l9-6 9 6M5 9v11h14V9M9 20v-6h6v6M9 17h6" /> break;
        case "garage": <path d="M3 9l9-5 9 5v11H3zM6.5 20v-8h11v8M6.5 15h11M6.5 18h11" /> break;
        case "attic": <path d="M2.5 13L12 4l9.5 9M5 11v9h14v-9M10 15a2 2 0 0 1 4 0" /> break;
        case "closet": <rect x="4" y="3" width="16" height="18" rx="1" /><path d="M12 3v18M10 11v2M14 11v2" /> break;
        case "cabinet": <rect x="4" y="4" width="16" height="16" rx="1" /><path d="M4 12h16M10 8h4M10 16h4" /> break;
        case "shelf": <path d="M3 5h18M3 12h18M3 19h18M5 5v14M19 5v14M8 9h2v3H8zM12 8.5h2.5V12H12zM9 15.5h3V19H9z" /> break;
        case "rack": <path d="M5 3v18M19 3v18M5 8h14M5 13.5h14M5 19h14" /><rect x="7.5" y="9.5" width="4" height="4" /><rect x="13" y="15" width="4" height="4" /> break;
        case "drawer": <rect x="3" y="4" width="18" height="16" rx="1" /><path d="M3 12h18M10 8h4M10 16h4" /> break;
        case "box": <path d="M3.5 8L12 4l8.5 4v8.5L12 21l-8.5-4.5zM3.5 8L12 12l8.5-4M12 12v9" /> break;
        case "bag": <path d="M5 8h14l-1 12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zM9 8V6a3 3 0 0 1 6 0v2" /> break;
        case "house": <path d="M3 11l9-7 9 7M5.5 9.5V20h13V9.5M10 20v-5.5h4V20" /> break;
        case "note": <path d="M5 4h10l4 4v12H5zM15 4v4h4M8.5 12.5h7M8.5 16h4.5" /> break;
        case "search": <circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /> break;
        case "fold": <path d="M7 4l5 5 5-5M7 20l5-5 5 5" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
