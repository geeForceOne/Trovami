@* The "New location" form: name, kind, where it goes, label and color. The page passes in the
   create step; it shows errors itself and returns the new id, or null when it didn't work.
   "Save and add another" keeps the dialog open with the same parent and kind. *@
@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="new-location-title" @onkeydown="OnKeyDown">
            <h2 id="new-location-title">New location</h2>
            <form class="form" @onsubmit="() => SubmitAsync(another: false)" @onsubmit:preventDefault="true">
                <div class="field-row field-row-wrap">
                    <label class="field field-grow">
                        <span>Name</span>
                        <input class="input" @bind="_name" @bind:event="oninput" @ref="_nameInput" maxlength="@Location.MaxNameLength" autocomplete="off" />
                    </label>
                    <label class="field">
                        <span>Kind</span>
                        <KindSelect @bind-Value="_kind" />
                    </label>
                </div>
                <div class="field">
                    <span>Inside</span>
                    @if (_picking)
                    {
                        <div class="new-loc-parent">
                            <LocationPicker Tree="_tree" Current="_parentId" AutoFocus="true" Placeholder="Pick a location…" OnPick="PickParent" />
                            @if (_parentId is not null)
                            {
                                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => PickParent(null)">Top level</button>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _picking = false">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="new-loc-parent">
                            <span class="new-loc-path">@(_parentId is null ? "Top level" : _tree.PathOf(_parentId))</span>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _picking = true">Change</button>
                        </div>
                    }
                </div>
                <label class="field">
                    <span>Label <span class="muted">(what's written on it)</span></span>
                    <input class="input input-short input-code" @bind="_label" @bind:event="oninput" maxlength="@Location.MaxLabelLength" placeholder="B12" autocomplete="off" />
                </label>
                <div class="field">
                    <span>Color</span>
                    <div class="swatches" role="radiogroup" aria-label="Color">
                        <button type="button" class="swatch swatch-none @(_color is null ? "on" : "")" role="radio" aria-checked="@(_color is null ? "true" : "false")" title="No color" @onclick="() => _color = null"><Icon Name="x" Size="14" /></button>
                        @foreach (var (key, label) in LocationColors.All)
                        {
                            <button type="button" class="swatch @(_color == key ? "on" : "")" style="--loc:var(--c-@key)" role="radio" aria-checked="@(_color == key ? "true" : "false")" title="@label" aria-label="@label" @onclick="() => _color = key"></button>
                        }
                    </div>
                </div>
                @if (_added > 0)
                {
                    <p class="muted small">@($"{Format.Count(_added, "location", "locations")} added so far.")</p>
                }
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="Close">@(_added > 0 ? "Done" : "Cancel")</button>
                    <button type="button" class="btn btn-secondary" disabled="@(!CanSave)" @onclick="() => SubmitAsync(another: true)">Save and add another</button>
                    <button type="submit" class="btn btn-primary" disabled="@(!CanSave)">Save</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record NewLocation(Guid? ParentId, string Name, LocationKind Kind, string? Label, string? Color);

    private bool _visible;
    private bool _focusPending;
    private bool _busy;
    private bool _picking;
    private LocationTree _tree = new([]);
    private Guid? _parentId;
    private string _name = "";
    private LocationKind _kind;
    private string? _label;
    private string? _color;
    private int _added;
    private Guid? _lastId;
    private Func<NewLocation, Task<Guid?>> _create = default!;
    private Func<LocationTree> _currentTree = default!;
    private ElementReference _nameInput;
    private TaskCompletionSource<Guid?>? _tcs;

    private bool CanSave => !_busy && !_picking && !string.IsNullOrWhiteSpace(_name);

    // Resolves to the last location created, or null if none was. currentTree: the page's tree,
    // read again after each save so a location just added can be the next parent.
    public Task<Guid?> AskAsync(Func<LocationTree> currentTree, Guid? parentId, Func<NewLocation, Task<Guid?>> create)
    {
        _tcs?.TrySetResult(null);
        _currentTree = currentTree;
        _tree = currentTree();
        _create = create;
        _parentId = parentId;
        _kind = parentId is null ? (_tree.Count == 0 ? LocationKind.House : LocationKind.Room) : KindSelect.ChildKind(_tree.Find(parentId)!.Kind);
        _name = "";
        _label = null;
        _color = null;
        _added = 0;
        _lastId = null;
        _picking = false;
        _busy = false;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<Guid?>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _nameInput.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_picking) Close();
    }

    private void PickParent(Guid? id)
    {
        _parentId = id;
        _picking = false;
        _kind = id is null ? LocationKind.Room : KindSelect.ChildKind(_tree.Find(id)!.Kind);
        _focusPending = true;
    }

    private async Task SubmitAsync(bool another)
    {
        if (!CanSave) return;
        _busy = true;
        Guid? id;
        try
        {
            id = await _create(new NewLocation(_parentId, _name.Trim(), _kind, string.IsNullOrWhiteSpace(_label) ? null : _label.Trim(), _color));
        }
        finally
        {
            _busy = false;
        }
        if (id is null)
            return;
        _lastId = id;
        _added++;
        if (!another)
        {
            Close();
            return;
        }
        _tree = _currentTree();
        _name = "";
        _label = null;
        _focusPending = true;
        StateHasChanged();
    }

    private void Close()
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(_lastId);
    }
}
